# Application ID: Settings > Application > General in the Sendbird Dashboard
NEXT_PUBLIC_SENDBIRD_APP_ID=
# API tokens on the same page. A secondary token is safer than the master token. Server only: never prefix it with NEXT_PUBLIC_.
SENDBIRD_API_TOKEN=
# Signs the demo sign-in cookie. Optional for `npm run dev`, required in production.
# Use at least 32 random characters, for example from `openssl rand -base64 32` (44 characters).
SESSION_SECRET=
